#!/usr/bin/env bash

# Lacy Shell CLI
# https://github.com/lacymorrow/lacy
#
# Usage: lacy [command] [options]
#
# Set LACY_NO_NODE=1 to force bash-only mode (skip the Node UI).
# Set NO_COLOR=1 for plain output.

set -e

VERSION_FALLBACK="1.8.23"
INSTALL_DIR="${HOME}/.lacy"
INSTALL_DIR_OLD="${HOME}/.lacy-shell"
CONFIG_FILE="${INSTALL_DIR}/config.yaml"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" 2>/dev/null && pwd)"

# Keep in sync with LACY_TOOL_LIST in lib/core/constants.sh (tests check).
TOOL_LIST=(lash claude opencode gemini codex hermes copilot goose amp aider)

# Colors (ANSI-C quoting so escape bytes are real, not literal)
# A dumb terminal renders escapes as garbage: treat it like NO_COLOR.
# Not exported, so child processes are unaffected.
if [[ "${TERM:-}" == "dumb" && -z "${NO_COLOR:-}" ]]; then NO_COLOR=1; fi
if [[ -n "${NO_COLOR:-}" ]]; then
    RED="" GREEN="" YELLOW="" BLUE="" CYAN="" BOLD="" DIM="" NC=""
else
    RED=$'\033[0;31m'
    GREEN=$'\033[0;32m'
    YELLOW=$'\033[1;33m'
    BLUE=$'\033[0;34m'
    CYAN=$'\033[0;36m'
    BOLD=$'\033[1m'
    DIM=$'\033[2m'
    NC=$'\033[0m'
fi

# ============================================================================
# Version: single source of truth is package.json
# ============================================================================

get_version() {
    local pkg_file="${INSTALL_DIR}/package.json"
    if [[ -f "$pkg_file" ]]; then
        grep '"version"' "$pkg_file" 2>/dev/null | head -1 | sed 's/.*"version"[[:space:]]*:[[:space:]]*"//' | sed 's/".*//'
    fi
}

VERSION="$(get_version)"
VERSION="${VERSION:-$VERSION_FALLBACK}"

# ============================================================================
# Helpers
# ============================================================================

die() { printf "${RED}Error: %s${NC}\n" "$1" >&2; exit 1; }

info() { printf "${BLUE}%s${NC}\n" "$1"; }

success() { printf "${GREEN}✓${NC} %s\n" "$1"; }

warn() { printf "${YELLOW}%s${NC}\n" "$1"; }

fail_line() { printf "  ${RED}✗${NC} %s\n" "$1"; }

fix_line() { printf "    Fix: %s\n" "$1"; }

# Installed means the plugin is there, not just that a directory exists.
is_installed() {
    [[ -f "${INSTALL_DIR}/lacy.plugin.zsh" ]] || [[ -f "${INSTALL_DIR_OLD}/lacy.plugin.zsh" ]]
}

command_exists() {
    command -v "$1" >/dev/null 2>&1
}

detect_shell() {
    local shell
    shell=$(basename "${SHELL:-}")
    case "$shell" in
        zsh|bash|fish) echo "$shell" ;;
        *)
            if command_exists zsh; then
                echo "zsh"
            else
                echo "bash"
            fi
            ;;
    esac
}

get_rc_file() {
    case "$(detect_shell)" in
        bash)
            if [[ "$OSTYPE" == "darwin"* ]]; then
                echo "${HOME}/.bash_profile"
            else
                echo "${HOME}/.bashrc"
            fi
            ;;
        fish) echo "${HOME}/.config/fish/conf.d/lacy.fish" ;;
        *)    echo "${HOME}/.zshrc" ;;
    esac
}

get_plugin_file() {
    echo "lacy.plugin.$(detect_shell)"
}

# An uncommented line that sources a lacy plugin
rc_has_plugin() {
    [[ -f "$1" ]] && grep -Eq '^[[:space:]]*(source|\.)[[:space:]]+[^#]*lacy\.plugin\.(zsh|bash|fish)' "$1" 2>/dev/null
}

# Parse a simple YAML value (strips inline comments and quotes)
yaml_value() {
    local file="$1" key="$2"
    grep "^[[:space:]]*${key}:" "$file" 2>/dev/null | head -1 | sed 's/^[^:]*:[[:space:]]*//' | sed 's/[[:space:]]*#.*//' | tr -d '"' | tr -d "'"
}

# Write a YAML value (replace in-place within a section)
yaml_write() {
    local file="$1" key="$2" value="$3"
    # Escape sed special chars in value (delimiter is |)
    local escaped_value="${value//\\/\\\\}"
    escaped_value="${escaped_value//|/\\|}"
    escaped_value="${escaped_value//&/\\&}"
    if grep -q "^[[:space:]]*${key}:" "$file" 2>/dev/null; then
        # Replace existing key: handles both "key: value" and "key:" (empty)
        sed -i.bak "s|^\\([[:space:]]*${key}:\\).*|\\1 ${escaped_value}|" "$file"
        command rm -f "${file}.bak"
    fi
}

# run_with_timeout SECONDS CMD...: output discarded, 124 on timeout.
run_with_timeout() {
    local secs="$1" pid ticks=0
    shift
    "$@" >/dev/null 2>&1 &
    pid=$!
    while kill -0 "$pid" 2>/dev/null; do
        if [[ $ticks -ge $((secs * 10)) ]]; then
            kill "$pid" 2>/dev/null || true
            wait "$pid" 2>/dev/null || true
            return 124
        fi
        sleep 0.1
        ticks=$((ticks + 1))
    done
    wait "$pid"
}

# Try the Node UI. Exits when it finishes or the user presses Ctrl+C;
# returns 1 to fall back to bash (no Node, no terminal, offline, or a crash).
try_node() {
    [[ "${LACY_NO_NODE:-}" == "1" ]] && return 1
    [[ -t 0 && -t 1 ]] || return 1
    command_exists npx && command_exists npm || return 1
    run_with_timeout 20 npm view lacy version || return 1

    local rc=0
    npx --yes lacy@latest "$@" || rc=$?
    stty sane 2>/dev/null || true
    case "$rc" in
        0)   exit 0 ;;
        130) exit 130 ;;
    esac
    return 1
}

# read that treats Ctrl+D as an empty answer instead of exiting under set -e
prompt_read() {
    local __var="$1" __prompt="$2" __reply=""
    printf "%s" "$__prompt"
    IFS= read -r __reply || { printf "\n"; __reply=""; }
    printf -v "$__var" '%s' "$__reply"
}

# Offer to restart the shell
offer_restart() {
    local restart=""
    [[ -t 0 ]] || return 0
    printf "\n"
    prompt_read restart "Restart shell now to apply changes? [Y/n]: "
    if [[ ! "$restart" =~ ^[Nn]$ ]]; then
        local shell_cmd
        shell_cmd=$(detect_shell)
        info "Restarting ${shell_cmd}..."
        exec "$shell_cmd" -l
    fi
}

# Find a script that ships in the repo root (install.sh, uninstall.sh).
# The copy next to this CLI comes first so both are the same version.
find_repo_script() {
    local name="$1" dir
    for dir in "${SCRIPT_DIR}/.." "$INSTALL_DIR" "$INSTALL_DIR_OLD"; do
        if [[ -f "${dir}/${name}" ]]; then
            echo "${dir}/${name}"
            return 0
        fi
    done
    return 1
}

# Run install.sh from a temp copy (it replaces the directory it lives in).
run_installer() {
    local src tmp rc=0
    src=$(find_repo_script install.sh) || die "install.sh not found. Run: curl -fsSL https://lacy.sh/install | bash"
    tmp=$(mktemp "${TMPDIR:-/tmp}/lacy-install-XXXXXX")
    cp "$src" "$tmp"
    LACY_NO_NODE=1 bash "$tmp" "$@" || rc=$?
    command rm -f "$tmp"
    return "$rc"
}

# ============================================================================
# Commands
# ============================================================================

cmd_install() {
    try_node "$@" || true

    if find_repo_script install.sh >/dev/null; then
        run_installer "$@" || exit $?
        return
    fi

    info "Downloading installer..."
    exec bash <(curl -fsSL https://lacy.sh/install) "$@"
}

cmd_uninstall() {
    local script confirm=""

    # Node UI asks, then runs uninstall.sh itself
    try_node --uninstall || true

    if ! script=$(find_repo_script uninstall.sh); then
        if [[ -e "$INSTALL_DIR" || -L "$INSTALL_DIR" || -e "$INSTALL_DIR_OLD" ]]; then
            die "uninstall.sh not found. Run: curl -fsSL https://lacy.sh/install | bash -s -- --uninstall"
        fi
        warn "Lacy Shell is not installed"
        exit 0
    fi

    if [[ -t 0 ]]; then
        prompt_read confirm "Uninstall Lacy Shell? [y/N]: "
        if [[ ! "$confirm" =~ ^[Yy]$ ]]; then
            echo "Cancelled."
            exit 0
        fi
    fi

    local tmp rc=0
    tmp=$(mktemp "${TMPDIR:-/tmp}/lacy-uninstall-XXXXXX")
    cp "$script" "$tmp"
    bash "$tmp" || rc=$?
    command rm -f "$tmp"
    exit "$rc"
}

cmd_update() {
    is_installed || die "Lacy Shell is not installed. Run: lacy install"
    run_installer --update || exit $?
}

cmd_reinstall() {
    run_installer --reinstall || exit $?
}

cmd_status() {
    printf "\n${BOLD}Lacy Shell${NC}\n\n"

    if is_installed; then
        local dir="$INSTALL_DIR"
        [[ -f "${dir}/lacy.plugin.zsh" ]] || dir="$INSTALL_DIR_OLD"
        if [[ -L "$dir" ]]; then
            success "Installed at ${dir} -> $(readlink "$dir")"
        else
            success "Installed at ${dir}"
        fi

        if [[ -d "${dir}/.git" ]]; then
            local ref
            ref=$(git -C "$dir" describe --tags --always 2>/dev/null || echo "unknown")
            printf "  Version: %s (git: %s)\n" "$VERSION" "$ref"
        else
            printf "  Version: %s\n" "$VERSION"
        fi
    else
        fail_line "Not installed"
        printf "\n  Run: ${CYAN}lacy install${NC}\n\n"
        return
    fi

    local rc_file
    rc_file=$(get_rc_file)
    if rc_has_plugin "$rc_file"; then
        success "Shell configured ($(basename "$rc_file"))"
    else
        printf "  ${YELLOW}○${NC} Shell not configured\n"
    fi

    if [[ -f "$CONFIG_FILE" ]]; then
        local active
        active=$(yaml_value "$CONFIG_FILE" "active")
        printf "  Active tool: ${CYAN}%s${NC}\n" "${active:-auto-detect}"
    else
        printf "  ${YELLOW}○${NC} No config file\n"
    fi

    printf "\n${BOLD}AI CLI Tools${NC}\n"
    local t
    for t in "${TOOL_LIST[@]}"; do
        if command_exists "$t"; then
            success "$t"
        else
            printf "  ${DIM}○ %s${NC}\n" "$t"
        fi
    done

    printf "\n${BOLD}PATH${NC}\n"
    case ":${PATH}:" in
        *":${INSTALL_DIR}/bin:"*) success "~/.lacy/bin in PATH" ;;
        *) printf "  ${YELLOW}○${NC} ~/.lacy/bin not in PATH\n" ;;
    esac

    echo ""
}

cmd_info() {
    local script
    for script in "${INSTALL_DIR}/packages/lacy/commands/info.sh" "${SCRIPT_DIR}/../packages/lacy/commands/info.sh"; do
        if [[ -f "$script" ]]; then
            bash "$script"
            return
        fi
    done
    printf "Lacy Shell v%s. Run ${CYAN}lacy help${NC} to see commands.\n" "$VERSION"
}

cmd_doctor() {
    printf "\n${BOLD}Lacy Shell Doctor${NC} ${DIM}v${VERSION}${NC}\n\n"

    local issues=0
    local shell rc_file plugin_file
    shell=$(detect_shell)
    rc_file=$(get_rc_file)
    plugin_file=$(get_plugin_file)

    # Installation
    if [[ -f "${INSTALL_DIR}/${plugin_file}" ]]; then
        success "Installed (${INSTALL_DIR}/${plugin_file})"
    else
        fail_line "Plugin missing: ${INSTALL_DIR}/${plugin_file}"
        fix_line "${CYAN}lacy reinstall${NC}"
        issues=$((issues + 1))
    fi

    # rc file: an uncommented source line
    if rc_has_plugin "$rc_file"; then
        success "Plugin loaded from $(basename "$rc_file")"
    elif [[ -f "$rc_file" ]] && grep -q "lacy\.plugin" "$rc_file" 2>/dev/null; then
        fail_line "The Lacy line in $(basename "$rc_file") is commented out"
        fix_line "uncomment ${CYAN}source ~/.lacy/${plugin_file}${NC}"
        issues=$((issues + 1))
    else
        fail_line "Plugin not loaded from $(basename "$rc_file")"
        fix_line "add ${CYAN}source ~/.lacy/${plugin_file}${NC} to $(basename "$rc_file")"
        issues=$((issues + 1))
    fi

    # Bash version (the plugin needs 4+)
    if [[ "$shell" == "bash" ]]; then
        local bash_bin="bash" bash_major
        [[ "${SHELL:-}" == */bash ]] && bash_bin="$SHELL"
        bash_major=$("$bash_bin" -c 'echo ${BASH_VERSINFO[0]}' 2>/dev/null || echo 0)
        if [[ "$bash_major" -ge 4 ]]; then
            success "bash ${bash_major}"
        else
            fail_line "bash ${bash_major} is too old (Lacy needs 4 or newer)"
            fix_line "${CYAN}brew install bash${NC}, then make it your login shell"
            issues=$((issues + 1))
        fi
    fi

    # Config and the configured AI tool
    local active="" custom_cmd="" t
    if [[ -f "$CONFIG_FILE" ]]; then
        success "Config file exists"
        active=$(yaml_value "$CONFIG_FILE" "active")
    else
        fail_line "No config file"
        fix_line "${CYAN}lacy install${NC} writes one"
        issues=$((issues + 1))
    fi

    if [[ "$active" == "custom" ]]; then
        custom_cmd=$(yaml_value "$CONFIG_FILE" "custom_command")
        local custom_bin="${custom_cmd%% *}"
        if [[ -n "$custom_bin" ]] && command_exists "$custom_bin"; then
            success "Custom tool available (${custom_bin})"
        else
            fail_line "Custom command not found: ${custom_bin:-(empty)}"
            fix_line "set ${CYAN}custom_command${NC} with ${CYAN}lacy config edit${NC}"
            issues=$((issues + 1))
        fi
    elif [[ -n "$active" ]]; then
        local known=0
        for t in "${TOOL_LIST[@]}"; do
            [[ "$t" == "$active" ]] && known=1
        done
        if [[ $known -eq 0 ]]; then
            fail_line "Unknown AI tool in config: ${active}"
            fix_line "${CYAN}lacy setup${NC} (choose from: ${TOOL_LIST[*]})"
            issues=$((issues + 1))
        elif command_exists "$active"; then
            success "AI tool available (${active})"
        else
            fail_line "Configured AI tool is not installed: ${active}"
            if [[ "$active" == "lash" ]]; then
                fix_line "${CYAN}npm install -g lashcode${NC}, or pick another tool with ${CYAN}lacy setup${NC}"
            else
                fix_line "install ${active}, or pick another tool with ${CYAN}lacy setup${NC}"
            fi
            issues=$((issues + 1))
        fi
    else
        local found=""
        for t in "${TOOL_LIST[@]}"; do
            if command_exists "$t"; then
                found="$t"
                break
            fi
        done
        if [[ -n "$found" ]]; then
            success "AI tool available (auto-detect: ${found})"
        else
            fail_line "No AI CLI tool installed"
            fix_line "${CYAN}npm install -g lashcode${NC} (lash.lacy.sh)"
            issues=$((issues + 1))
        fi
    fi

    # PATH
    case ":${PATH}:" in
        *":${INSTALL_DIR}/bin:"*) success "~/.lacy/bin in PATH" ;;
        *)
            fail_line "~/.lacy/bin not in PATH (the lacy command may be missing in new shells)"
            fix_line "open a new terminal, or add ${CYAN}export PATH=\"\$HOME/.lacy/bin:\$PATH\"${NC}"
            issues=$((issues + 1))
            ;;
    esac

    echo ""
    if [[ $issues -eq 0 ]]; then
        printf "${GREEN}All checks passed.${NC}\n\n"
        return 0
    fi
    printf "${YELLOW}%d issue(s) found${NC}\n\n" "$issues"
    exit 1
}

cmd_config() {
    if [[ ! -f "$CONFIG_FILE" ]]; then
        die "No config file. Run: lacy install"
    fi

    case "${1:-}" in
        edit)
            local editor="${EDITOR:-${VISUAL:-vi}}"
            exec "$editor" "$CONFIG_FILE"
            ;;
        path)
            echo "$CONFIG_FILE"
            ;;
        show|"")
            cat "$CONFIG_FILE"
            ;;
        *)
            echo "Usage: lacy config [show|edit|path]"
            ;;
    esac
}

cmd_setup() {
    if ! is_installed; then
        die "Lacy Shell is not installed. Run: lacy install"
    fi

    try_node setup || true

    cmd_setup_bash
}

cmd_setup_bash() {
    if [[ ! -f "$CONFIG_FILE" ]]; then
        die "No config file. Run: lacy install"
    fi

    local choice active mode
    while true; do
        active=$(yaml_value "$CONFIG_FILE" "active")
        mode=$(yaml_value "$CONFIG_FILE" "default")

        printf "\n${BOLD}Lacy Shell${NC} ${DIM}v${VERSION}${NC}\n\n"
        printf "  1) Change AI tool     ${DIM}(current: ${active:-auto-detect})${NC}\n"
        printf "  2) Change mode        ${DIM}(current: ${mode:-auto})${NC}\n"
        printf "  3) Edit config        ${DIM}(open in \$EDITOR)${NC}\n"
        printf "  4) Back\n"
        printf "\n"

        prompt_read choice "Select [1-4]: "

        case "$choice" in
            1) setup_tool ;;
            2) setup_mode ;;
            3)
                local editor="${EDITOR:-${VISUAL:-vi}}"
                "$editor" "$CONFIG_FILE"
                ;;
            4|"") break ;;
            *) warn "Invalid choice" ;;
        esac
    done
}

setup_tool() {
    printf "\n${BOLD}Select AI tool${NC}\n\n"

    local tools=("${TOOL_LIST[@]}" custom auto)
    local i=1 t choice custom_cmd
    for t in "${tools[@]}"; do
        if [[ "$t" == "custom" ]]; then
            printf "  %d) %-12s ${DIM}%s${NC}\n" "$i" "$t" "enter your own command"
        elif [[ "$t" == "auto" ]]; then
            printf "  %d) %-12s ${DIM}%s${NC}\n" "$i" "$t" "use the first one installed"
        elif command_exists "$t"; then
            printf "  ${GREEN}%d)${NC} %-12s ${GREEN}installed${NC}\n" "$i" "$t"
        else
            printf "  %d) %s\n" "$i" "$t"
        fi
        i=$((i + 1))
    done
    printf "\n"

    prompt_read choice "Select [1-${#tools[@]}]: "

    if [[ -z "$choice" ]] || ! [[ "$choice" =~ ^[0-9]+$ ]] || [[ "$choice" -lt 1 ]] || [[ "$choice" -gt ${#tools[@]} ]]; then
        warn "Cancelled"
        return
    fi

    local selected="${tools[$((choice-1))]}"

    if [[ "$selected" == "custom" ]]; then
        prompt_read custom_cmd "Enter custom command: "
        if [[ -z "$custom_cmd" ]]; then
            warn "No command entered. Cancelled."
            return
        fi
        yaml_write "$CONFIG_FILE" "active" "custom"
        yaml_write "$CONFIG_FILE" "custom_command" "\"$custom_cmd\""
        success "Tool set to: custom ($custom_cmd)"
    elif [[ "$selected" == "auto" ]]; then
        yaml_write "$CONFIG_FILE" "active" ""
        success "Tool set to: auto-detect"
    else
        yaml_write "$CONFIG_FILE" "active" "$selected"
        success "Tool set to: $selected"
    fi

    offer_restart
}

setup_mode() {
    local choice
    printf "\n${BOLD}Select default mode${NC}\n\n"
    printf "  1) auto     ${DIM}smart detection (recommended)${NC}\n"
    printf "  2) shell    ${DIM}all commands execute directly${NC}\n"
    printf "  3) agent    ${DIM}all input goes to AI${NC}\n"
    printf "\n"

    prompt_read choice "Select [1-3]: "

    case "$choice" in
        1) yaml_write "$CONFIG_FILE" "default" "auto"; success "Mode set to: auto" ;;
        2) yaml_write "$CONFIG_FILE" "default" "shell"; success "Mode set to: shell" ;;
        3) yaml_write "$CONFIG_FILE" "default" "agent"; success "Mode set to: agent" ;;
        *) warn "Cancelled"; return ;;
    esac

    offer_restart
}

cmd_enter() {
    # Already inside a lacy shell session: show info instead of nesting
    if [[ "${LACY_SHELL_ACTIVE:-}" == "1" ]]; then
        cmd_info
        return
    fi

    if ! is_installed; then
        die "Lacy Shell is not installed. Run: lacy install"
    fi

    # Launch an interactive shell; the plugin loads from the rc file
    local shell
    shell=$(detect_shell)
    exec "$shell" -li
}

cmd_new() {
    local shell_home="${LACY_SHELL_HOME:-${HOME}/.lacy}"
    local last_session_file="${shell_home}/.last_session"
    if [[ -f "$last_session_file" ]]; then
        command rm -f "$last_session_file"
        success "Last session cleared"
    else
        info "No saved session to clear"
    fi
    printf '\n%b\n' "Next query will start a fresh context."
}

cmd_resume() {
    local shell_home="${LACY_SHELL_HOME:-${HOME}/.lacy}"
    local last_session_file="${shell_home}/.last_session"
    if [[ ! -f "$last_session_file" ]]; then
        warn "No previous session found"
        printf '\n%b\n' "Start chatting to create a session, then type ${CYAN}/resume${NC} to pick it up in another shell."
        return 1
    fi

    local saved_tool saved_id
    { read -r saved_tool; read -r saved_id; } < "$last_session_file" || true

    if [[ -z "$saved_tool" || -z "$saved_id" ]]; then
        warn "Saved session file is empty"
        return 1
    fi

    printf '\n%b\n' "${BOLD}Last session${NC}"
    printf '  Tool:    %s\n' "$saved_tool"
    printf '  Session: %s\n' "$saved_id"
    printf '\n%b\n' "Type ${CYAN}/resume${NC} inside Lacy Shell to load this session."
}

cmd_logs() {
    local log_file="${INSTALL_DIR}/logs/queries.log"

    case "${1:-}" in
        --clear|-c)
            if [[ -f "$log_file" ]]; then
                command rm -f "$log_file"
                success "Query log cleared"
            else
                info "No log file found"
            fi
            return
            ;;
        --count)
            if [[ -f "$log_file" ]]; then
                local count
                count=$(wc -l < "$log_file" 2>/dev/null || echo 0)
                printf "Entries: %s\n" "$count"
            else
                echo "0"
            fi
            return
            ;;
    esac

    if [[ ! -f "$log_file" ]]; then
        info "No queries logged yet."
        printf '\nStart using Lacy Shell and queries will appear here.\n\n'
        return
    fi

    local limit="${1:-50}"
    if [[ "$limit" =~ ^[0-9]+$ ]]; then
        printf "\n${BOLD}Recent queries${NC} ${DIM}(last %s)${NC}\n\n" "$limit"
        tail -n "$limit" "$log_file" | while IFS=$'\t' read -r ts tool query; do
            printf "  ${DIM}%s${NC}  ${CYAN}%-12s${NC}  %s\n" "$ts" "$tool" "$query"
        done
    else
        printf "\n${BOLD}All queries${NC}\n\n"
        while IFS=$'\t' read -r ts tool query; do
            printf "  ${DIM}%s${NC}  ${CYAN}%-12s${NC}  %s\n" "$ts" "$tool" "$query"
        done < "$log_file"
    fi
    echo ""
    printf "${DIM}Log: %s${NC}\n\n" "$log_file"
}

cmd_changelog() {
    printf "\n${BOLD}Lacy Shell Changelog${NC}\n\n"

    # Try fetching from GitHub releases API
    if command_exists curl; then
        local json
        json=$(curl -sf --max-time 5 \
            -H "Accept: application/vnd.github+json" \
            "https://api.github.com/repos/lacymorrow/lacy/releases/latest" 2>/dev/null || true)

        if [[ -n "$json" ]]; then
            local tag body
            tag=$(printf '%s\n' "$json" | grep '"tag_name"' | head -1 | sed 's/.*"tag_name"[[:space:]]*:[[:space:]]*"//' | sed 's/".*//')
            body=$(printf '%s\n' "$json" | python3 -c "
import json, sys
try:
    d = json.loads(sys.stdin.read())
    print(d.get('body', ''))
except: pass" 2>/dev/null || true)

            if [[ -n "$tag" ]]; then
                printf "${CYAN}Latest release: %s${NC}\n\n" "$tag"
                if [[ -n "$body" ]]; then
                    printf '%s\n' "$body"
                else
                    printf "${DIM}No release notes.${NC}\n"
                fi
                echo ""
                return
            fi
        fi
    fi

    # Fallback: show local CHANGELOG.md if present
    local changelog_file="${INSTALL_DIR}/CHANGELOG.md"
    if [[ -f "$changelog_file" ]]; then
        head -n 80 "$changelog_file"
        echo ""
        return
    fi

    # Last resort: recent git log
    if [[ -d "${INSTALL_DIR}/.git" ]]; then
        warn "Could not fetch release notes (offline?). Showing recent commits:"
        echo ""
        git -C "$INSTALL_DIR" log --oneline -20 2>/dev/null || true
    else
        warn "Could not fetch changelog. Run \`lacy update\` to get the latest version."
    fi
    echo ""
}

cmd_completions() {
    local shell_type="${1:-}"

    if [[ -z "$shell_type" ]]; then
        shell_type=$(detect_shell)
    fi

    case "$shell_type" in
        zsh)  _completions_zsh ;;
        bash) _completions_bash ;;
        *)
            warn "Unknown shell: $shell_type. Use 'zsh' or 'bash'."
            exit 1
            ;;
    esac
}

_completions_zsh() {
    cat <<'ZSHCOMP'
#compdef lacy

_lacy() {
    local -a commands
    commands=(
        'setup:Change AI tool, mode, or config'
        'install:Install Lacy Shell'
        'uninstall:Remove Lacy Shell'
        'update:Move to the latest release'
        'reinstall:Fresh copy of the latest release'
        'status:Show installation status'
        'info:Show a short introduction'
        'doctor:Check for common problems'
        'config:Show or edit configuration'
        'new:Forget the saved agent session'
        'resume:Show the saved agent session'
        'logs:Show recent agent query log'
        'changelog:Show latest release notes'
        'completions:Print a completion script'
        'version:Show version'
        'help:Show help'
    )

    case "$words[2]" in
        config)
            local -a config_sub
            config_sub=('show:Print config file' 'edit:Open in $EDITOR' 'path:Print config path')
            _describe 'config subcommand' config_sub
            ;;
        logs)
            local -a logs_sub
            logs_sub=('--clear:Clear the log file' '--count:Print entry count')
            _describe 'logs option' logs_sub
            ;;
        completions)
            local -a shells
            shells=('zsh:zsh completion' 'bash:bash completion')
            _describe 'shell' shells
            ;;
        *)
            _describe 'lacy command' commands
            ;;
    esac
}

_lacy "$@"
ZSHCOMP
}

_completions_bash() {
    cat <<'BASHCOMP'
_lacy_completions() {
    local cur prev
    cur="${COMP_WORDS[COMP_CWORD]}"
    prev="${COMP_WORDS[COMP_CWORD-1]}"

    local commands="setup install uninstall update reinstall status info doctor config new resume logs changelog completions version help"

    case "$prev" in
        config)
            COMPREPLY=( $(compgen -W "show edit path" -- "$cur") )
            return
            ;;
        logs)
            COMPREPLY=( $(compgen -W "--clear --count" -- "$cur") )
            return
            ;;
        completions)
            COMPREPLY=( $(compgen -W "zsh bash" -- "$cur") )
            return
            ;;
    esac

    COMPREPLY=( $(compgen -W "$commands" -- "$cur") )
}

complete -F _lacy_completions lacy
BASHCOMP
}

cmd_version() {
    echo "lacy $VERSION"
    if [[ -d "${INSTALL_DIR}/.git" ]]; then
        local ref
        ref=$(git -C "$INSTALL_DIR" describe --tags --always 2>/dev/null || echo "")
        [[ -n "$ref" ]] && echo "git: $ref"
    fi
    return 0
}

cmd_help() {
    cat <<EOF
${BOLD}Lacy Shell${NC} ${DIM}v${VERSION}${NC}: talk directly to your shell

${BOLD}Usage:${NC}
  lacy                Open a shell with Lacy loaded
  lacy <command>      Run a command

${BOLD}Commands:${NC}
  setup          Change AI tool, mode, or config
  install        Install Lacy Shell
  uninstall      Remove Lacy Shell
  update         Move to the latest release
  reinstall      Fresh copy of the latest release (keeps config)
  status         Show installation status
  info           Show a short introduction
  doctor         Check for common problems
  config         Show config (config edit, config path)
  new            Forget the saved agent session
  resume         Show the saved agent session
  logs [N]       Show the last N agent queries (default: 50)
  logs --clear   Clear the query log
  changelog      Show the latest release notes
  completions    Print a completion script (zsh or bash)
  version        Show version
  help           Show this help

${BOLD}Inside Lacy:${NC}
  mode           Show or switch mode (shell, agent, auto)
  tool           Show or switch AI tool
  ask "query"    Send a query straight to the AI tool
  /new           Start a fresh conversation
  /resume        Resume the last conversation
  quit           Leave Lacy (exit closes the shell)
  Ctrl+Space     Switch mode

${BOLD}Environment:${NC}
  LACY_NO_NODE=1    Skip the Node UI
  NO_COLOR=1        Plain output

${DIM}https://github.com/lacymorrow/lacy${NC}
EOF
}

# ============================================================================
# Main
# ============================================================================

main() {
    local cmd="${1:-}"
    shift 2>/dev/null || true

    case "$cmd" in
        setup)      cmd_setup "$@" ;;
        install)    cmd_install "$@" ;;
        uninstall)  cmd_uninstall "$@" ;;
        update)     cmd_update "$@" ;;
        reinstall)  cmd_reinstall "$@" ;;
        status|s)   cmd_status "$@" ;;
        info)       cmd_info ;;
        doctor)     cmd_doctor "$@" ;;
        config|c)   cmd_config "$@" ;;
        new|/new|reset|/reset|clear|/clear) cmd_new "$@" ;;
        resume|/resume)                     cmd_resume "$@" ;;
        logs)         cmd_logs "$@" ;;
        changelog)    cmd_changelog "$@" ;;
        completions)  cmd_completions "$@" ;;
        version|-v|--version) cmd_version ;;
        help|-h|--help)       cmd_help ;;
        "")                   cmd_enter ;;
        *)
            printf "${RED}Unknown command: %s${NC}\n\n" "$cmd"
            cmd_help
            exit 1
            ;;
    esac
}

main "$@"
